{
  "name": "pdf-filler",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Preenchimento local da ficha e-SUS Notifica (COVID-19, 05/10/2020) por sobreposição em PDF",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:overlay": "tsx scripts/verify-overlay.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
